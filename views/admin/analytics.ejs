<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seraphic | Analytics</title>
    <link rel="stylesheet" href="/css/analytics.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header class="analytics-header">
        <a href="/admin/dashboard" class="back-link">
            ← Dashboard
        </a>
        <h1>Seraphic Analytics</h1>

        <p>Understand your store's performance</p>
    </header>

    <main class="analytics-container">

        <section class="period-section">
            <h2>Sales Overview</h2>
            <div class="period-buttons">
                <button class="period-btn active" data-period="7days">
                    7 Days
                </button>

                <button class="period-btn" data-period="6months">
                    6 Months
                </button>

                <button class="period-btn" data-period="1year">
                    1 Year
                </button>

            </div>

        </section>

        <section class="stats-grid">

            <div class="stat-card">
                <h3>Total Revenue</h3>
                <p id="totalRevenue">₹0</p>
            </div>

            <div class="stat-card">
                <h3>Total Orders</h3>
                <p id="totalOrders">0</p>
            </div>

            <div class="stat-card">
                <h3>Products Sold</h3>
                <p id="totalProductsSold">0</p>
            </div>

            <div class="stat-card">
                <h3>Average Order Value</h3>
                <p id="averageOrderValue">₹0</p>
            </div>

        </section>

        <section class="chart-section">
            <h2>Revenue Trend</h2>

            <div class="chart-container">
                <canvas id="salesChart"></canvas>
            </div>
        </section>

        </main>

        <script src="/js/analytics.js"></script>
</body>
</html>