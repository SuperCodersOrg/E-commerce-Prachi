<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | Seraphic</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 25px;
            font-family: Arial, sans-serif;
            background: #F8F5F0;
            color: #49372D;
        }

        .header, .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .panel {
            margin-top: 24px;
            padding: 22px;
            background: white;
            border-radius: 10px;
        }

        a, button {
            padding: 10px 14px;
            border: none;
            border-radius: 5px;
            background: #49372D;
            color: white;
            text-decoration: none;
            cursor: pointer;
        }

        .delete {
            background: #a32626;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #E5DCD1;
        }

        img {
            width: 65px;
            height: 65px;
            object-fit: cover;
        }

        form {
            margin: 0;
        }
    </style>
</head>

<body>
    <header class="header">
        <h1>Seraphic Admin</h1>
        <a href="/home">View Store</a>

        <a href="/admin/analytics" class="analytics-link">
    <span>📊</span>
    View Analytics
</a>
    </header>

    <section class="panel">
        <h2>Admin Profile</h2>

        <p>
            <strong>Name:</strong>
            <%= admin.username || "Administrator" %>
        </p>

        <p>
            <strong>Email:</strong>
            <%= admin.email %>
        </p>

        <p>
            <strong>Role:</strong>
            Administrator
        </p>
    </section>

    <section class="panel">
        <div class="section-header">
            <h2>Products (<%= products.length %>)</h2>
            <a href="/admin/products/new">+ Create Product</a>
        </div>

        <% if (products.length === 0) { %>
            <p>No products found.</p>
        <% } else { %>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td>
                                    <img
                                        src="/<%= product.image.replace(/^public\//, '') %>"
                                        alt="<%= product.name %>"
                                    >
                                </td>

                                <td><%= product.name %></td>
                                <td><%= product.brand %></td>
                                <td><%= product.category %></td>
                                <td>₹<%= product.price %></td>
                                <td><%= product.stock %></td>

                                <td>
                                    <form
                                        action="/admin/products/<%= product._id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this product?')"
                                    >
                                        <button
                                            type="submit"
                                            class="delete"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</body>
</html>