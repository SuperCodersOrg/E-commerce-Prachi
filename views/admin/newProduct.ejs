<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Product | Seraphic Admin</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            padding: 25px;
            font-family: Arial, sans-serif;
            background: #F8F5F0;
            color: #49372D;
        }

        .container {
            max-width: 650px;
            margin: 25px auto;
            padding: 25px;
            background: white;
            border-radius: 10px;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input, textarea {
            width: 100%;
            margin-top: 7px;
            padding: 11px;
            border: 1px solid #E5DCD1;
            border-radius: 5px;
        }

        button, a {
            display: inline-block;
            margin-top: 18px;
            padding: 11px 15px;
            border: none;
            border-radius: 5px;
            background: #49372D;
            color: white;
            text-decoration: none;
            cursor: pointer;
        }

        .error {
            color: #a32626;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Create Product</h1>

        <a href="/admin/dashboard">Back to Dashboard</a>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form
            action="/admin/products"
            method="POST"
            enctype="multipart/form-data"
        >
            <label for="name">Product Name</label>
            <input
                id="name"
                name="name"
                type="text"
                required
            >

            <label for="brand">Brand</label>
            <input
                id="brand"
                name="brand"
                type="text"
                required
            >

            <label for="category">Category</label>
            <input
                id="category"
                name="category"
                type="text"
                required
            >

            <label for="size">Size</label>
            <input
                id="size"
                name="size"
                type="text"
                required
            >

            <label for="price">Price (₹)</label>
            <input
                id="price"
                name="price"
                type="number"
                min="0"
                step="0.01"
                required
            >

            <label for="stock">Stock Quantity</label>
            <input
                id="stock"
                name="stock"
                type="number"
                min="0"
                step="1"
                required
            >

            <label for="ratings">Rating (0–5)</label>
            <input
                id="ratings"
                name="ratings"
                type="number"
                min="0"
                max="5"
                step="0.1"
                value="0"
                required
            >

            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="5"
                required
            ></textarea>

            <label for="image">Product Image</label>
            <input
                id="image"
                name="image"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif"
                required
            >

            <button type="submit">Post Product</button>
        </form>
    </div>
</body>
</html>