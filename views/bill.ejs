<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Bill</title>
    <link rel="stylesheet" href="/css/bill.css">

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body data-order-id="<%= internalOrderId %>" data-razorpay-key="<%= razorpayKey || '' %>">

    <h1>Order Summary</h1>

    <% orderItems.forEach(item => { %>

        <div>
            <h3><%= item.name %></h3>
            <p>Price: ₹<%= item.price %></p>
            <p>Quantity: <%= item.quantity %></p>
            <p>Subtotal: ₹<%= item.price * item.quantity %></p>
        </div>

        <hr>

    <% }); %>

    <div>
        <p>Subtotal: ₹<%= subtotal.toFixed(2) %></p>
        <% if (discountAmount > 0) { %>
            <p>Membership discount (<%= discountPercent %>%): -₹<%= discountAmount.toFixed(2) %></p>
        <% } %>
    </div>

    <h2>Total: ₹<%= total.toFixed(2) %></h2>

    <button type="button" id="payNow">
        Pay Now
    </button>

    <p id="paymentMessage"></p>

    <script>
        const internalOrderId = document.body.dataset.orderId;

        const razorpayKey = document.body.dataset.razorpayKey;

        const payButton = document.getElementById("payNow");
        const paymentMessage = document.getElementById("paymentMessage");

        payButton.addEventListener("click", async () => {
            try {
                payButton.disabled = true;
                paymentMessage.textContent = "Preparing payment...";

                const createResponse = await fetch("/home/payment/create", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({ internalOrderId })
                });

                const orderData = await createResponse.json();

                if (!createResponse.ok || !orderData.success) {
                    throw new Error(
                        orderData.message || "Unable to create payment."
                    );
                }

                const options = {
                    key: orderData.key || razorpayKey,
                    amount: orderData.amount,
                    currency: orderData.currency,
                    name: "Seraphic",
                    description: "Order Payment",
                    order_id: orderData.orderId,

                    handler: async function (paymentResponse) {
                        try {
                            paymentMessage.textContent =
                                "Verifying your payment...";

                            const verifyResponse = await fetch(
                                "/home/payment/verify",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json"
                                    },
                                    credentials: "same-origin",
                                    body: JSON.stringify({
                                        internalOrderId,
                                        razorpay_payment_id:
                                            paymentResponse.razorpay_payment_id,
                                        razorpay_order_id:
                                            paymentResponse.razorpay_order_id,
                                        razorpay_signature:
                                            paymentResponse.razorpay_signature
                                    })
                                }
                            );

                            const verifyData = await verifyResponse.json();

                            if (!verifyResponse.ok || !verifyData.success) {
                                throw new Error(
                                    verifyData.message ||
                                    "Payment verification failed."
                                );
                            }

                            window.location.href =
                                `/home/payment/success/${verifyData.orderId}`;

                        } catch (error) {
                            console.error("Verification error:", error);
                            paymentMessage.textContent = error.message;
                            payButton.disabled = false;
                        }
                    },

                    modal: {
                        ondismiss: function () {
                            paymentMessage.textContent =
                                "Payment window closed. Your cart has not been cleared.";
                            payButton.disabled = false;
                        }
                    },

                    theme: {
                        color: "#49372D"
                    }
                };

                const checkout = new Razorpay(options);

                checkout.on("payment.failed", function (response) {
                    paymentMessage.textContent =
                        response.error.description ||
                        "Payment failed. Please try again.";

                    payButton.disabled = false;
                });

                checkout.open();

            } catch (error) {
                console.error("Payment error:", error);
                paymentMessage.textContent = error.message;
                payButton.disabled = false;
            }
        });
    </script>

</body>
</html>