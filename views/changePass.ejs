
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password | Seraphic</title>

    <link rel="stylesheet" href="/css/changePass.css">
</head>
<body>

    <header class="brand">
        <h1>Seraphic</h1>
        <p class="tagline">Elegance in every detail</p>
    </header>

    <main class="page-container">
        <div class="password-card">

            <div class="icon-circle">
                <span>✧</span>
            </div>

            <h2>Change Your Password</h2>
            <p class="subtitle">
                Keep your account safe with a strong, unique password.
            </p>

            <form action="/auth/changePass" method="POST">
<!-- 
                <label for="username">Username: </label>
                <input type="text" placeholder="username" id="username" name="username">

                <br/><br/> -->
                <label for="email">Email: </label>
                <input type="email" placeholder="Enter your Email" id="email" name="email">

                <label for="password">Current Password: </label>
                <input type="password" name="password" id="password" placeholder="Current password">

                <br/><br/>
                <label for="newPassword">New Password: </label>
                <input type="password" name="newPassword" placeholder="New password" id="newPassword" required>
                <br/><br/>

                <label for="rePassword">Confirm Password: </label>
                <input type="password" name="rePassword" placeholder="Confirm password" id="rePassword" required>

                <input type="submit" placeholder="Submit">
            </form>

            <p class="back-login">
                Remember your password?
                <a href="/auth/login">Back to Login</a>
            </p>

            <p class="security-note">♡ &nbsp; Your security matters to us</p>
        </div>
    </main>

    <footer>
        © 2026 Seraphic · Designed with elegance
    </footer>

</body>
</html>