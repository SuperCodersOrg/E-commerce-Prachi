<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/home.css">
    <title>Home</title>
</head>
<body>
    <%- include('./partials/header.ejs') %>
     
    <div class="product-grid">
    <% fileData.forEach(product=>{ %>
         <div class="product-card">

            <img src="/<%= product.image.replace(/^public\//, '') %>" alt="<%= product.name %>">

            <a href="/home/products/<%= product.id %>"> View Details  </a>

            <a href="/home/cart/<%= product.id %>" data-productId="<%= product.id %>" id="addToCart">Add to cart</a>

         </div>
    <% }); %>
         </div>
          <button type="button" id="load-more" data-next-cursor= "<%= nextCursor || ''%>" <%= hasMore ? '' : 'hidden' %>>Load More.</button>

    <script src="/js/home.js" defer></script>
    <script src="/js/addToCart.js" defer></script>

</body>
</html>