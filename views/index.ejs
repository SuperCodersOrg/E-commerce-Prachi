<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Seraphic </title>
    <link rel="stylesheet" href="/css/index.css">
</head>

<body>

    <header class="navbar">
        <a href="/" class="logo">Seraphic</a>

        <nav>
            <a href="/auth/login">Login</a>
            <a href="/auth/signin">Sign Up</a>
        </nav>
    </header>

    <main class="hero">
        <div class="hero-content">
            <p class="subtitle">WELCOME TO SERAPHIC</p>

            <h1>Discover Your<br>Personal Style.</h1>

            <p class="description">
                Explore timeless fashion, elegant styles, and
                collections designed to make every moment special.
            </p>

            <div class="hero-buttons">

                <a href="/auth/login" class="secondary-btn">Login</a>

                <a href="/home" class="primary-btn">Get Started</a>

            </div>
        </div>

        <div class="hero-image">
            <img src="/images/bodycon.png" alt="Featured fashion collection">
        </div>
    </main>

    <footer>
        <p>© 2026 Seraphic. Style that speaks for you.</p>

    <form action="/auth/logout" method="POST" class="logout-form">
        <button type="submit" class="logout-link">Logout</button>
    </form>
         

    </footer>


</body>

</html>